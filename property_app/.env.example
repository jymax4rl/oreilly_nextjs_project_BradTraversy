# Copy to .env.local for local development. Never commit real secrets.
# Production (Vercel / Docker): set these in the host environment.

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=https://www.isisel.com
NEXT_PUBLIC_DOMAIN=https://www.isisel.com
NEXT_PUBLIC_APP_URL=https://www.isisel.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CURRENCY_EXCHANGE_RATE_API=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# --- Google Maps / Places (list-property address + map pin) ---
# Create a key in Google Cloud Console → APIs & Services → Credentials.
# Enable BOTH:
#   1) Maps JavaScript API  (map + markers)
#   2) Places API (New)     (address autocomplete / place details)
# Do NOT rely on legacy Places Autocomplete — it throws LegacyApiNotActivatedMapError
# when the old Places API is off (correct: leave legacy Places disabled).
# Restrict the key by HTTP referrer: http://localhost:3000/*, https://www.isisel.com/*, https://*.vercel.app/*
# Do NOT commit real keys. Without this, hosts can still enter address manually + soft pin.
#
# Docker: NEXT_PUBLIC_* is inlined at image build. Use:
#   npm run docker:release -- --tag mvp
# (script passes Maps keys from .env.local as build-args). Runtime --env-file alone is not enough.
#
# Vercel production name (preferred on isisel.com):
GOOGLE_MAPS_API_KEY=
# Local / explicit browser name (also fine). next.config maps GOOGLE_MAPS_API_KEY → this at build:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional alias (same key works if you prefer this name):
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
#
# Optional Map ID for Advanced Markers (teal custom pin). Create one under
# Google Cloud → Google Maps Platform → Map Management → Create Map ID
# (Map type: JavaScript, then enable Advanced Markers / vector if prompted).
# For quick local testing you may use Google's sample: DEMO_MAP_ID
# Without a Map ID, the wizard still shows a classic teal pin marker.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Auth (NextAuth + Google) ---
NEXTAUTH_URL=https://www.isisel.com
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ops staff Credentials password (script only — never commit the value):
#   OPS_PASSWORD="..." npm run ops:set-password
#   OPS_PASSWORD="..." OPS_EMAIL="camara23.pro@gmail.com" npm run ops:set-password
# Optional: OPS_PROMOTE=1  OPS_ROLE=admin|superadmin
# OPS_PASSWORD=
# OPS_EMAIL=
# One-time /ops/login founder form — locks email when bootstrap is open:
# OPS_FOUNDER_EMAIL=camara23.pro@gmail.com

# --- Database ---
MONGODB_URI=

# --- Cloudinary (server) ÔÇö use CLOUDINARY_URL *or* the three discrete vars ---
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional ops/scripts only:
CLOUDINARY_LEGACY_HOST_ID=

# --- Payments ---
# Default checkout is offline (arrange payment with host).
# Set NEXT_PUBLIC_USE_PAYMENT_GATEWAY=true to enable online checkout.
# The browser only sees NEXT_PUBLIC_* flags — secret CREEM_/GENIUSPAY_ keys
# stay on the server. With the gateway flag on, guests see MoMo + card unless
# you disable a method below.
# NEXT_PUBLIC_USE_PAYMENT_GATEWAY=true
# Preferred provider when both are configured: geniuspay | creem
# NEXT_PUBLIC_PAYMENT_PROVIDER=geniuspay
# Optional per-method UI toggles (default: both on when gateway is on)
# NEXT_PUBLIC_GENIUSPAY_CHECKOUT=true
# NEXT_PUBLIC_CREEM_CHECKOUT=true

# Soft-launch: online checkout is limited to ops staff and partner host
# Sadio Diallo (matched by name on the listing/host, or by email below).
# PAYMENT_PARTNER_EMAILS=sadio@example.com
# NEXT_PUBLIC_PAYMENT_PARTNER_EMAILS=sadio@example.com

# Creem (dashboard → API keys). Prefer CREEM_PRODUCTION for live card checkout.
# Toggle Test Mode OFF in the Creem sidebar, then copy the live key + create a
# live product. Test keys start with creem_test_ and always open /test/ checkout.
# Product IDs are per mode — a test prod_… will 404 ("Product not found") on live.
# CREEM_PRODUCTION=creem_...        # LIVE key (NOT creem_test_…) — production only
# CREEM_API_KEY=creem_test_...      # test key — preview/dev only
# CREEM_PRODUCT_ID=prod_...         # one-time stay product (fallback)
# CREEM_PRODUCT_ID_LIVE=prod_...    # optional live-only product id
# CREEM_PRODUCT_ID_TEST=prod_...    # optional test-only product id
# If the product id is missing/stale, checkout searches for / creates
# an "Isisel stay" one-time product automatically.
# CREEM_WEBHOOK_SECRET=             # Developers → Webhooks (use live secret in prod)
# CREEM_SERVER=live                 # optional; mode follows the key prefix
# Webhook URL: https://<host>/api/payments/creem/webhook

# GeniusPay (MoMo + international card/wallets via hosted checkout)
# Dashboard: https://geniuspay.ci — use production or sandbox key pair
# GENIUSPAY_API_KEY=pk_live_...          # or GENIUSPAY_PUBLIC_KEY
# GENIUSPAY_API_SECRET=sk_live_...       # or GENIUSPAY_SECRET_KEY
# GENIUSPAY_WEBHOOK_SECRET=whsec_...
# GENIUSPAY_USD_TO_XOF=600               # African MoMo charge FX (USD→XOF)
# GENIUSPAY_USD_TO_EUR=0.92              # fallback FX when live rates unavailable
# Guest currency selector is sent as `currency` on initialize:
#   African MoMo currencies → charge XOF (Wave/Orange/MTN/…)
#   EUR → charge EUR; other non-African → charge USD (card / Apple Pay / Google Pay)
# Webhook URL: https://<host>/api/payments/geniuspay/webhook
# Docs: https://geniuspay.ci/docs/api
# MCP (optional for AI IDEs): https://geniuspay.ci/api/mcp

# Flutterwave (deprecated — prefer GeniusPay)
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=
# NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# --- Email (Resend) ---
# Domain isisel.com is verified. Bookings / moderation stay on this mailbox.
EMAIL_FROM=Camara Djehuty <camara-djehuty@isisel.com>
EMAIL_REPLY_TO=camara-djehuty@isisel.com
# Ops Marketing. From and Reply-To must be @isisel.com (Resend + a real inbox).
# Add jimmeh@isisel.com in Resend (or send any address on the verified domain).
# Vercel env vars do not apply to npm run dev — set these in .env.local too.
MARKETING_EMAIL_FROM=Jimmeh <jimmeh@isisel.com>
MARKETING_EMAIL_REPLY_TO=jimmeh@isisel.com
# Public / admin inbox:
ADMIN_EMAIL=contact@isisel.com
RESEND_API_KEY=
RESEND_BOOKING_API_KEY=
RESEND_ADMIN_API_KEY=
RESEND_TEMPLATE_GUEST_ID=
RESEND_TEMPLATE_HOST_ID=
RESEND_TEMPLATES_READY=

# --- Ops documentation (optional harden) ---
# By default any Ops staff role can open /documentation.
# Set to 1 to require @isisel.com (or OPS_DOCUMENTATION_EMAILS allowlist):
# OPS_DOCUMENTATION_RESTRICT_EMAIL=1
# OPS_EMAIL_DOMAIN=isisel.com
# OPS_DOCUMENTATION_EMAILS=founder@gmail.com,ops@partner.com

# Project: isisel / javascript-nextjs (SaaS).
# Copy DSN from Sentry → Project Settings → Client Keys (DSN).
# Without a DSN, the SDK stays disabled and the app behaves as before.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only alias (falls back to NEXT_PUBLIC_SENTRY_DSN):
# SENTRY_DSN=
# Optional environment label override (defaults to VERCEL_ENV / NODE_ENV):
# SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Trace sample rates (0–1). Defaults: 0.1 server/client.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session Replay: off for normal sessions; on for sessions that hit an error.
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
# Build-time only (Vercel): enables source map upload + release creation.
# Create at https://sentry.io/settings/auth-tokens/ (org: isisel).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=isisel
# SENTRY_PROJECT=javascript-nextjs

# --- Runtime (optional; Next defaults to 3000) ---
# PORT=3000
