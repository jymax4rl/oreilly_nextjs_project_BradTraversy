# Copy to .env.local for local development. Never commit real secrets.
# Production (Vercel / Docker): set these in the host environment.

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=https://www.isisel.com
NEXT_PUBLIC_DOMAIN=https://www.isisel.com
NEXT_PUBLIC_APP_URL=https://www.isisel.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CURRENCY_EXCHANGE_RATE_API=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# --- Google Maps / Places (list-property address + map pin) ---
# Create a key in Google Cloud Console → APIs & Services → Credentials.
# Enable BOTH:
#   1) Maps JavaScript API  (map + markers)
#   2) Places API (New)     (address autocomplete / place details)
# Do NOT rely on legacy Places Autocomplete — it throws LegacyApiNotActivatedMapError
# when the old Places API is off (correct: leave legacy Places disabled).
# Restrict the key by HTTP referrer: http://localhost:3000/*, https://www.isisel.com/*, https://*.vercel.app/*
# Do NOT commit real keys. Without this, hosts can still enter address manually + soft pin.
#
# Docker: NEXT_PUBLIC_* is inlined at image build. Use:
#   npm run docker:release -- --tag mvp
# (script passes Maps keys from .env.local as build-args). Runtime --env-file alone is not enough.
#
# Vercel production name (preferred on isisel.com):
GOOGLE_MAPS_API_KEY=
# Local / explicit browser name (also fine). next.config maps GOOGLE_MAPS_API_KEY → this at build:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional alias (same key works if you prefer this name):
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
#
# Optional Map ID for Advanced Markers (teal custom pin). Create one under
# Google Cloud → Google Maps Platform → Map Management → Create Map ID
# (Map type: JavaScript, then enable Advanced Markers / vector if prompted).
# For quick local testing you may use Google's sample: DEMO_MAP_ID
# Without a Map ID, the wizard still shows a classic teal pin marker.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Auth (NextAuth + Google) ---
NEXTAUTH_URL=https://www.isisel.com
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ops staff Credentials password (script only — never commit the value):
#   OPS_PASSWORD="..." npm run ops:set-password
#   OPS_PASSWORD="..." OPS_EMAIL="camara23.pro@gmail.com" npm run ops:set-password
# Optional: OPS_PROMOTE=1  OPS_ROLE=admin|superadmin
# OPS_PASSWORD=
# OPS_EMAIL=
# One-time /ops/login founder form — locks email when bootstrap is open:
# OPS_FOUNDER_EMAIL=camara23.pro@gmail.com

# --- Database ---
MONGODB_URI=

# --- Cloudinary (server) ÔÇö use CLOUDINARY_URL *or* the three discrete vars ---
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional ops/scripts only:
CLOUDINARY_LEGACY_HOST_ID=

# --- Payments (Flutterwave) ---
# Default checkout is offline (arrange payment with host). Set to true to restore Flutterwave modal.
# NEXT_PUBLIC_USE_PAYMENT_GATEWAY=true
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# --- Email (Resend) ---
# Domain isisel.com is verified. Bookings / moderation stay on this mailbox.
EMAIL_FROM=Camara Djehuty <camara-djehuty@isisel.com>
EMAIL_REPLY_TO=camara-djehuty@isisel.com
# Ops Marketing. From and Reply-To must be @isisel.com (Resend + a real inbox).
# Add jimmeh@isisel.com in Resend (or send any address on the verified domain).
# Vercel env vars do not apply to npm run dev — set these in .env.local too.
MARKETING_EMAIL_FROM=Jimmeh <jimmeh@isisel.com>
MARKETING_EMAIL_REPLY_TO=jimmeh@isisel.com
# Public / admin inbox:
ADMIN_EMAIL=contact@isisel.com
RESEND_API_KEY=
RESEND_BOOKING_API_KEY=
RESEND_ADMIN_API_KEY=
RESEND_TEMPLATE_GUEST_ID=
RESEND_TEMPLATE_HOST_ID=
RESEND_TEMPLATES_READY=

# --- Runtime (optional; Next defaults to 3000) ---
# PORT=3000
